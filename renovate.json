{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "The NATS packages pin each other to an exact version: they move together.",
      "matchPackageNames": ["@nats-io/**"],
      "groupName": "nats client"
    },
    {
      "description": "The OpenTelemetry packages share peer ranges across their release lines.",
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "opentelemetry"
    },
    {
      "description": "The Testcontainers modules depend on the same version of the core package.",
      "matchPackageNames": ["testcontainers", "@testcontainers/**"],
      "groupName": "testcontainers"
    },
    {
      "description": "Patch, pin and digest updates merge on their own once CI is green.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Group updates to Cadenway packages.",
      "matchPackageNames": ["@cadenway/**"],
      "groupName": "cadenway packages"
    },
    {
      "description": "TypeScript stays on 6.0 until typescript-eslint accepts a newer line.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
