{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Kept inside dist so that deleting dist also discards the incremental state: left next to
    // the sources, it would make `tsc -b` skip the package and never emit it again.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.int-spec.ts"]
}
