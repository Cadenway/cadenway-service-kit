{
  "name": "@cadenway/nest-common",
  "version": "0.7.0",
  "description": "Plumbing shared by the Cadenway NestJS services and gateways: configuration, logs, telemetry, health routes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cadenway/cadenway-service-kit.git",
    "directory": "packages/nest-common"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./hook.mjs": "./hook.mjs",
    "./register": "./register.mjs"
  },
  "files": [
    "dist",
    "hook.mjs",
    "register.mjs",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "body-parser": "^2.4.0",
    "cockatiel": "^4.0.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@opentelemetry/api": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "^6.0.0",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/body-parser": "^1.19.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "catalog:",
    "ioredis": "^6.0.0",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "^12.2.1",
    "zod": "catalog:"
  }
}
