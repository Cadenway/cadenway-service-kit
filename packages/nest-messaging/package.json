{
  "name": "@cadenway/nest-messaging",
  "version": "0.1.1",
  "description": "Messaging plumbing for the Cadenway NestJS services and gateways: NATS JetStream connection, outbox publication, subscriptions with retries and dead letters, deduplication.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cadenway/cadenway-service-kit.git",
    "directory": "packages/nest-messaging"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0"
  },
  "peerDependencies": {
    "@cadenway/contracts": ">=0.2.0 <1.0.0",
    "@cadenway/nest-common": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@cadenway/contracts": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cadenway/nest-common": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@testcontainers/nats": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "testcontainers": "^12.2.1",
    "zod": "catalog:"
  }
}
